PORT=3000
NODE_ENV=development

# Gemini AI — get from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Google Maps Places API Key (Server-side lookup fallback)
# Get from: https://console.cloud.google.com/google/maps-apis
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# JWT Secret & Expiry
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# MongoDB — leave blank for in-memory prototype store
MONGODB_URI=

# Temporary PII is deleted from the prototype store after this purpose window.
RETENTION_MINUTES=30

# CORS
CORS_ORIGIN=http://localhost:5173

# Extraction performance controls
GEMINI_TIMEOUT_MS=30000
EXTRACTION_CACHE_TTL_MINUTES=30
EXTRACTION_CACHE_MAX_ITEMS=100
PREPROCESS_MAX_EDGE=1280
PREPROCESS_JPEG_QUALITY=78
PDF_MAX_PAGES=2
# Keep false on small deployments: PaddleOCR loads lazily only if Gemini fails.
PADDLE_WARMUP_ON_START=false
